{
	"app-id": "io.gitlab.zehkira.Monophony",
	"runtime": "org.gnome.Platform",
	"runtime-version": "48",
	"sdk": "org.gnome.Sdk",
	"command": "monophony",
	"finish-args": [
		"--socket=pulseaudio",
		"--socket=wayland",
		"--socket=fallback-x11",
		"--share=ipc",
		"--share=network",
		"--device=dri",
		"--own-name=org.mpris.MediaPlayer2.Monophony"
	],
	"modules": [
		"python3-modules.json",
		{
			"name": "yt-dlp",
			"buildsystem": "simple",
			"build-commands": [
				"chmod +x yt-dlp",
				"mv yt-dlp ${FLATPAK_DEST}/bin/"
			],
			"sources": [{
				"type": "file",
				"url": "https://github.com/yt-dlp/yt-dlp/releases/download/2025.07.21/yt-dlp",
				"sha256": "d6ff4b07579a491436d83413cad1ff18f5fa2a01f80effceb9b70147276ffeb8"
			}]
		},
		{
			"name": "monophony",
			"buildsystem": "simple",
			"build-commands": [
				"pip install --prefix=${FLATPAK_DEST} --no-build-isolation .",
				"make prefix=${FLATPAK_DEST} install"
			],
			"sources": [{
				"type": "dir",
				"path": ".."
			}]
		}
	]
}
